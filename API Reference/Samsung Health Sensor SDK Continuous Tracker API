# 10. Continuous Recording 통합 Manager 예시

```kotlin
class ContinuousRecordingManager(
    private val healthTrackingService: HealthTrackingService,
    private val supportedTypes: List<HealthTrackerType>,
    private val onSampleReceived: (
        sensorType: String,
        timestamp: Long,
        valueName: String,
        value: String,
        status: Int?
    ) -> Unit
) {

    private var heartRateManager: HeartRateTrackerManager? = null
    private var ppgManager: PpgTrackerManager? = null
    private var accelerometerManager: AccelerometerTrackerManager? = null
    private var skinTemperatureManager: SkinTemperatureTrackerManager? = null
    private var edaManager: EdaTrackerManager? = null

    fun createTrackers() {
        if (supportedTypes.contains(HealthTrackerType.HEART_RATE_CONTINUOUS)) {
            heartRateManager = HeartRateTrackerManager(
                healthTrackingService,
                onSampleReceived
            )
            heartRateManager?.createTracker()
        }

        if (supportedTypes.contains(HealthTrackerType.PPG_CONTINUOUS)) {
            ppgManager = PpgTrackerManager(
                healthTrackingService,
                onSampleReceived
            )
            ppgManager?.createTracker()
        }

        if (supportedTypes.contains(HealthTrackerType.ACCELEROMETER_CONTINUOUS)) {
            accelerometerManager = AccelerometerTrackerManager(
                healthTrackingService,
                onSampleReceived
            )
            accelerometerManager?.createTracker()
        }

        if (supportedTypes.contains(HealthTrackerType.SKIN_TEMPERATURE_CONTINUOUS)) {
            skinTemperatureManager = SkinTemperatureTrackerManager(
                healthTrackingService,
                onSampleReceived
            )
            skinTemperatureManager?.createTracker()
        }

        if (supportedTypes.contains(HealthTrackerType.EDA_CONTINUOUS)) {
            edaManager = EdaTrackerManager(
                healthTrackingService,
                onSampleReceived
            )
            edaManager?.createTracker()
        }
    }

    fun startRecording() {
        heartRateManager?.startTracking()
        ppgManager?.startTracking()
        accelerometerManager?.startTracking()
        skinTemperatureManager?.startTracking()
        edaManager?.startTracking()
    }

    fun stopRecording() {
        heartRateManager?.stopTracking()
        ppgManager?.stopTracking()
        accelerometerManager?.stopTracking()
        skinTemperatureManager?.stopTracking()
        edaManager?.stopTracking()
    }
}
```

